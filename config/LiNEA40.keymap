#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <12>;
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <100>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <5>;
        input-processors = <&zip_xy_scaler 0 1>                           // 1. X 轴乘以 0 (完全锁定 X 轴)
                         , <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT> // 2. Y 轴方向反转
                         , <&zip_xy_to_scroll_mapper>;                  // 3. 转为滚轮
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        PrevClick {
            bindings = <&kp LC(PAGE_UP)>;
            key-positions = <27 26>;
        };

        ClickNext {
            bindings = <&kp LC(PAGE_DOWN)>;
            key-positions = <27 28>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W         &kp E               &kp R    &kp T                                &kp Y          &kp U  &kp I      &kp O       &kp P
&kp A          &kp S         &kp D               &kp F    &kp G                                &kp H          &kp J  &kp K      &kp L       &lt 5 SEMICOLON
&kp Z          &kp X         &kp C               &kp V    &kp B                                &kp N          &kp M  &kp COMMA  &kp DOT     &mt RIGHT_SHIFT SLASH
&mt LCTRL TAB  &kp LEFT_WIN  &mt LEFT_ALT GRAVE  &kp INS  &lt 3 SPACE  &lt 2 ESC    &kp ENTER  &kp BACKSPACE         &lt 4 SQT  &kp DELETE  &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans  &trans
            >;
        };

        //2

        MARK {
            bindings = <
&kp F1              &kp F2               &kp F3  &kp F4  &kp F5                        &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
&kp LA(LC(DELETE))  &kp LS(LG(S))        &trans  &trans  &kp C_MUTE                    &trans  &trans  &trans  &kp F11  &kp F12
&trans              &kp LA(PRINTSCREEN)  &trans  &trans  &trans                        &trans  &trans  &trans  &trans   &trans
&trans              &trans               &trans  &trans  &trans      &trans    &trans  &trans          &trans  &trans   &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3
        //4
        //5

        SCROLL {
            bindings = <
&kp EQUAL     &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK
&kp CAPSLOCK  &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp BACKSLASH
&kp HOME      &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans        &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };
    };
};
